// ============================================================
// NCKH: CoT Prompting + RAG Pipeline
// Ung dung ky thuat Chain-of-Thought Prompting trong
// phan tich va danh gia rui ro van ban hop dong
// ============================================================
// Dan toan bo noi dung nay vao Eraser.io > New File > Diagram
// ============================================================


// ═══════════════════════════════════════════
// PHASE 1: OFFLINE — XAY KHO TRI THUC PHAP LY
// ═══════════════════════════════════════════
Offline Phase [color: gray, icon: settings] {

  PDF Laws [label: "Van ban Phap ly\nBLLD 2019 - LTM 2005 - BLDS 2015\nND 145/2020 - ND 17/2022", color: gray, icon: file-text]

  Extract Law [label: "pdfplumber\nExtract Text tu PDF luat", color: blue, icon: scissors]

  Chunking [label: "Text Splitter\nChunk ~500 tokens\nSeparator: Dieu / Khoan", color: blue, icon: grid]

  Embed Law [label: "vietnamese-sbert\nEncode moi chunk -> vector 768D", color: purple, icon: cpu]

  ChromaDB [label: "ChromaDB\nPersistent Vector Store\n+ metadata: source, article", color: teal, icon: database]

}


// ═══════════════════════════════════════════
// PHASE 2: ONLINE — PHAN TICH HOP DONG
// ═══════════════════════════════════════════

// --- INPUT ---
Input [color: gray, icon: zap] {
  Contract PDF [label: "Upload Hop dong\nPDF / Text file", color: gray, icon: upload]
  PDF Extract [label: "pdfplumber\nExtract toan van hop dong", color: blue, icon: file]
  Segmenter [label: "Clause Segmenter\nHeuristic Rules\n'Dieu X:' pattern -> list clauses", color: blue, icon: list]
}


// --- RAG RETRIEVAL ---
Retrieval [color: amber, icon: search] {
  Embed Query [label: "Encode dieu khoan\nvietnamese-sbert -> vector 768D", color: purple, icon: cpu]
  Vector Search [label: "ChromaDB Query\ncosine similarity\nTop-3 chunks gan nhat", color: teal, icon: search]
  Legal Context [label: "Legal Context\nTop-3 doan luat lien quan\n+ metadata (nguon, dieu khoan)", color: amber, icon: book-open]
}


// --- COT ANALYSIS ---
CoT Analysis [color: coral, icon: sparkles] {

  Prompt Builder [label: "Structured CoT Prompt Builder\nSYSTEM: Role-based (chuyen gia phap ly AI)\nCONTEXT: {legal_context} top-3 doan luat\nCLAUSE: {clause_text}\nINSTRUCT: 4-step reasoning chain", color: coral, icon: edit]

  Gemini API [label: "Gemini 2.5 Flash API\ntemperature=0.1\nJSON output mode", color: coral, icon: sparkles]

  CoT Step1 [label: "Buoc 1 - NHAN DIEN\nDieu khoan quy dinh ve gi?\nQuyen & nghia vu moi ben?", color: orange, icon: eye]

  CoT Step2 [label: "Buoc 2 - DOI CHIEU LUAT\nPhu hop voi quy dinh?\nDiem nao vi pham / co nguy co?", color: orange, icon: scale]

  CoT Step3 [label: "Buoc 3 - DANH GIA RUI RO\nMuc do: Thap / Trung binh / Cao\nDiem rui ro: 1-10\nLy do + trich dan dieu luat", color: orange, icon: alert-triangle]

  CoT Step4 [label: "Buoc 4 - DE XUAT CHINH SUA\nNoi dung can sua / bo sung\nDe phu hop phap luat", color: orange, icon: edit-3]

  JSON Output [label: "JSON Output\nstep1_content\nstep2_legal_check\nstep3_risk_level: low|medium|high\nstep3_risk_score: 1-10\nstep3_legal_references\nstep4_suggestion", color: green, icon: code]

}


// --- SELF-REFLECTION ---
Self Reflection [color: pink, icon: refresh-cw] {

  Score Check [label: "Score Threshold Check\n3 <= score <= 4: gan nguong low/medium\n6 <= score <= 7: gan nguong medium/high", color: pink, icon: git-branch]

  Reflection Prompt [label: "Self-Reflection Prompt\nKiem tra lai toan bo ket qua:\n- Trich dan dieu luat co dung?\n- Muc rui ro co nhat quan?\n- De xuat co kha thi khong?\n- Co bo sot dieu khoan nao?", color: pink, icon: refresh-cw]

  Gemini Reflect [label: "Gemini 2.5 Flash\n2nd LLM Call\nRevised Analysis", color: coral, icon: sparkles]

  Revised Output [label: "Revised JSON\nneeds_revision: true/false\nrevised_analysis: {...}", color: green, icon: check-circle]

}


// --- FINAL OUTPUT ---
Output [color: green, icon: check-circle] {

  Risk Classifier [label: "Risk Classifier\nscore 1-3  -> LOW (Thap)\nscore 4-6  -> MEDIUM (Trung binh)\nscore 7-10 -> HIGH (Cao)", color: green, icon: tag]

  Final Report [label: "Final Report JSON\nclause_id, title, content\nrisk_level, risk_score\nlegal_references: [law, article, excerpt]\nsuggestion", color: green, icon: file-text]

  Web App [label: "Web App Display\n- Upload PDF\n- Highlight mau rui ro\n- Panel phan tich CoT\n- Trich dan dieu luat\n- De xuat chinh sua", color: teal, icon: monitor]

}


// ═══════════════════════════════════════════
// ARROWS — OFFLINE PHASE
// ═══════════════════════════════════════════
PDF Laws > Extract Law: load PDF
Extract Law > Chunking: raw text
Chunking > Embed Law: chunks ~500 tokens
Embed Law > ChromaDB: store vectors + metadata


// ═══════════════════════════════════════════
// ARROWS — ONLINE INPUT
// ═══════════════════════════════════════════
Contract PDF > PDF Extract: upload & extract
PDF Extract > Segmenter: full contract text
Segmenter > Embed Query: clause text (1 at a time)


// ═══════════════════════════════════════════
// ARROWS — RAG RETRIEVAL
// ═══════════════════════════════════════════
Embed Query > Vector Search: query vector 768D
ChromaDB > Vector Search: ANN lookup
Vector Search > Legal Context: top-3 chunks + metadata


// ═══════════════════════════════════════════
// ARROWS — COT ANALYSIS
// ═══════════════════════════════════════════
Legal Context > Prompt Builder: legal context
Segmenter > Prompt Builder: clause text
Prompt Builder > Gemini API: structured CoT prompt
Gemini API > CoT Step1: step 1 reasoning
CoT Step1 > CoT Step2: pass result
CoT Step2 > CoT Step3: pass result
CoT Step3 > CoT Step4: pass result
CoT Step4 > JSON Output: full 4-step analysis


// ═══════════════════════════════════════════
// ARROWS — SELF-REFLECTION
// ═══════════════════════════════════════════
JSON Output > Score Check: check risk_score value
Score Check > Reflection Prompt: score near threshold
Score Check > Risk Classifier: score clear -> skip reflection
Reflection Prompt > Gemini Reflect: send reflection prompt
Gemini Reflect > Revised Output: revised analysis
Revised Output > Risk Classifier: final result


// ═══════════════════════════════════════════
// ARROWS — FINAL OUTPUT
// ═══════════════════════════════════════════
Risk Classifier > Final Report: classified risk level
Final Report > Web App: render highlighted results

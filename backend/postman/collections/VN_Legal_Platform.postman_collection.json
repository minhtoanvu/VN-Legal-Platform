          "name": "Thống kê tổng quan 🔒",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{base_url}}/analytics/overview", "host": ["{{base_url}}"], "path": ["analytics", "overview"]}
          },
          "response": []
        }
      ]
    },
    {
      "name": "🕸️ Knowledge Graph",
      "description": "Truy vấn đồ thị tri thức pháp lý.",
